# ============================================================
# Environment TEMPLATE — tracked on purpose
# ============================================================
# Real environment files (.env, .env.local, backend/.env, ...) stay ignored
# by the rules above. The TEMPLATE is the one exception: it documents every
# variable the app reads, with placeholders only and never a real value, so
# it belongs in version control where a new developer or a deploy can find
# it. A negation has to come AFTER the patterns it overrides, because the
# last matching pattern in a .gitignore wins.
!.env.example
!**/.env.example

# Phase 6A/6B evaluation artifacts — regenerated by the eval/stability/
# resilience scripts on every run; never source of truth.
backend/eval.json
backend/stability.json
backend/baseline.json
backend/provider-resilience.json

# Point-in-time snapshots written by `npm run earnings:audit`.
backend/reports/
