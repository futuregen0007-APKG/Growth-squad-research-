# ============================================================
# STOCK MARKET AI - ENVIRONMENT CONFIGURATION
# ============================================================
# 
# This file documents ALL environment variables required for
# the application. Copy this file to .env and fill in your values.
# 
# HOW TO USE:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your API keys and configuration
# 3. Add .env to .gitignore (NEVER commit real keys!)
# 4. Restart server for changes to take effect
# 
# SECURITY NOTES:
# - Never commit .env files with real keys to git
# - Use .env for local development only
# - Use environment variables in production
# - Rotate API keys regularly if compromised
# 
# ============================================================

# ============================================================
# SERVER CONFIGURATION
# ============================================================

# Port on which Express server listens
# Default: 3000
PORT=3000

# Node environment (development, production, test)
# Default: development
NODE_ENV=development

# Logging level (DEBUG, INFO, WARN, ERROR)
# Default: DEBUG (verbose, for development)
# In production: INFO (less verbose)
LOG_LEVEL=DEBUG

# ============================================================
# MARKET DATA PROVIDER CONFIGURATION
# ============================================================
# 
# Angel One is the market data provider for NSE and BSE.
# You only need to configure the Angel One settings below.

# ───────────────────────────────────────────────────────────
# ANGEL ONE PROVIDER
# ───────────────────────────────────────────────────────────
MARKET_DATA_PROVIDER=angel-one
ANGEL_API_KEY=your_angel_one_api_key
ANGEL_CLIENT_CODE=your_angel_one_client_code
ANGEL_PIN=your_angel_one_pin
ANGEL_TOTP_SECRET=your_angel_one_totp_secret
ANGEL_CLIENT_LOCAL_IP=127.0.0.1
ANGEL_CLIENT_PUBLIC_IP=your_public_ip
ANGEL_MAC_ADDRESS=00-00-00-00-00-00
ANGEL_DEFAULT_EXCHANGE=NSE

# ───────────────────────────────────────────────────────────
# INDIAN API PROVIDER (company/fundamental research)
# ───────────────────────────────────────────────────────────
# IndianAPI supplies company profile, financials, key metrics,
# shareholding, corporate actions, analyst data, and news — it does NOT
# replace Angel One for live prices/quotes.
COMPANY_RESEARCH_PROVIDER=indian-api
INDIAN_API_KEY=your_indian_api_key
# Base URL depends on your indianapi.in plan:
#   Free/Hobby:      https://stock.indianapi.in
#   Developer:        https://dev.indianapi.in
#   Growth Analyst:    https://analyst.indianapi.in
#   Pro:               https://pro.indianapi.in
INDIAN_API_BASE_URL=https://stock.indianapi.in
INDIAN_API_TIMEOUT_MS=15000

# ============================================================
# CACHING CONFIGURATION (Redis)
# ============================================================
# 
# Redis stores cached stock prices to reduce API calls.
# 
# CACHE STRATEGY:
# - Stock prices: 5 minutes (volatile, updates frequently)
# - Company details: 1 hour (stable, rarely changes)
# - Market status: 1 minute (updates during market hours)
# 
# BENEFITS:
# - Faster responses (cache hit = instant response)
# - Lower API costs (fewer calls to Finnhub)
# - Better reliability (fallback if API down)
# 
# For LOCAL DEVELOPMENT:
# Install Redis:
#   - Windows: Use Windows Subsystem for Linux (WSL) or Docker
#   - Mac: brew install redis
#   - Linux: apt-get install redis-server
# 
# Start Redis:
#   - redis-server (default port 6379)
# 
# Or use Docker:
#   - docker run -p 6379:6379 redis:latest

# Redis connection URL (redis:// or rediss://). When set, it takes precedence
# over REDIS_HOST/PORT/PASSWORD/DB below. Hosted services provide this:
#   - Render Key Value INTERNAL url (redis://red-xxxx:6379) only resolves from
#     a Render service in the same region/workspace. It will NOT work from
#     your computer, so leave REDIS_URL unset locally.
#   - An external url (rediss://...) uses TLS and works from anywhere.
# Leave unset/empty to use the host settings below (local Docker Redis).
# REDIS_URL=

# Redis host (where Redis is running)
# Default: localhost (your computer)
REDIS_HOST=localhost

# Redis port
# Default: 6379 (standard Redis port)
REDIS_PORT=6379

# Redis password (if authentication required)
# Leave empty if no password set
# Default: empty
REDIS_PASSWORD=

# Redis database number (0-15)
# Default: 0
REDIS_DB=0

# Cache TTL in seconds
# Stock prices (shorter = fresher data, more API calls)
# Default: 300 (5 minutes)
CACHE_TTL_STOCK=300

# Company details (longer = less API calls, slightly stale data)
# Default: 3600 (1 hour)
CACHE_TTL_COMPANY=3600

# ============================================================
# WEBSOCKET CONFIGURATION (Live Price Updates)
# ============================================================
# 
# WebSocket allows real-time price updates to connected clients.
# 
# FLOW:
# 1. Client opens WebSocket connection
# 2. Subscribes to stock symbols
# 3. Server pushes price updates every N seconds
# 4. Client updates UI in real-time without polling
# 
# NOTE: Current implementation uses polling (interval).
# For production, consider using:
# - Finnhub WebSocket (free tier)
# - Socket.io for better compatibility
# - Server-sent events (SSE) as alternative

# WebSocket server port
# Default: 5001
# Must be different from main server port
WEBSOCKET_PORT=5001

# Price update interval in milliseconds
# Default: 5000 (5 seconds)
# Lower = more frequent updates = higher CPU/bandwidth
# Higher = less frequent updates = less responsive
# Recommended: 3000-10000 (3-10 seconds)
PRICE_UPDATE_INTERVAL=1000

# ============================================================
# DATABASE CONFIGURATION (Optional - for future features)
# ============================================================
# 
# For storing user watchlists, preferences, trade history, etc.
# Currently not used, but prepared for future expansion.

# MongoDB connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
# Or local: mongodb://localhost:27017/stock-market-ai
MONGODB_URI=mongodb://localhost:27017/stock-market-ai

# Database name
DATABASE_NAME=stock-market-ai

# ============================================================
# OPENAI CONFIGURATION (GS Copilot / LangGraph chat)
# ============================================================
#
# Used by GS Copilot's LangGraph workflow (backend/graph/) via the
# centralized llm/OpenAIClientFactory.js. Get a key from
# https://platform.openai.com/api-keys — never commit the real value.
#
# OPENAI_CHAT_MODEL: main reasoning/structured-output/streaming model.
# OPENAI_SUMMARY_MODEL: lower-cost model for conversation summarization
#   and cheap classification. Both default to 'gpt-4o-mini' if unset —
#   a model already proven to work against this project's account
#   (see services/openaiClient.js's existing Earnings Intelligence use).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_SUMMARY_MODEL=
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_REQUEST_TIMEOUT_MS=60000

# Optional: per-user GS Copilot chat rate limit (requests/minute). Defaults to 20.
CHAT_RATE_LIMIT_PER_MINUTE=20

# ============================================================
# CORS CONFIGURATION (API Security)
# ============================================================
# 
# CORS = Cross-Origin Resource Sharing
# Controls which frontend domains can access this API.
# 
# WHY CORS?
# - Security: Prevent unauthorized websites from using your API
# - Prevents: Malicious site.com from calling api.yourserver.com
# 
# EXAMPLE:
# - Allow: https://yourfrontend.com
# - Allow: http://localhost:3000 (local development)
# - Block: https://attacker.com

# Comma-separated list of allowed origins
# For development: localhost:3000
# For production: https://yourfrontend.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================
# MONITORING & LOGGING (Optional)
# ============================================================

# Sentry DSN for error tracking (optional)
# Setup: https://sentry.io
# SENTRY_DSN=https://key@sentry.io/project

# Enable health check endpoint
# GET /health returns server status
ENABLE_HEALTH_CHECK=true

# ============================================================
# EXAMPLE CONFIGURATION (Ready to use)
# ============================================================
# 
# Uncomment and modify this section for quick setup:
# 
# NODE_ENV=development
# PORT=3000
# LOG_LEVEL=DEBUG
# 
# FINNHUB_API_KEY=your_finnhub_api_key
# NEWS_API_KEY=your_news_api_key
# 
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# 
# CACHE_TTL_STOCK=300
# CACHE_TTL_COMPANY=3600
# 
# WEBSOCKET_PORT=5001
# PRICE_UPDATE_INTERVAL=5000
# 
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# 
# ============================================================

# ============================================================
# PHASE 5B — PRODUCTION OBSERVABILITY (all optional)
# ============================================================
# Every variable below is OPTIONAL. With none of them set, telemetry
# behaves exactly as Phase 5A shipped: events go to the console logger and
# an in-process metrics store, and /api/ops/rag-metrics reports this
# instance only. Nothing here is required to run the app.
#
# --- OTLP export (services/telemetry/otlpExporter.js) ---
# Setting the endpoint is what ENABLES export. Unset = no exporter is
# registered at all, and no background timer runs.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=          # full URL, overrides <endpoint>/v1/logs
# OTEL_EXPORTER_OTLP_HEADERS=api-key=xxx,x-tenant=yyy   # SECRET: collector credentials
# OTEL_SERVICE_NAME=gs-copilot-backend
# OTEL_DEPLOYMENT_ENVIRONMENT=production     # defaults to NODE_ENV
# OTEL_SDK_DISABLED=true                     # kill switch; disables export even with an endpoint set
# OTEL_BSP_MAX_QUEUE_SIZE=2048               # hard cap; oldest events dropped past it
# OTEL_BSP_MAX_EXPORT_BATCH_SIZE=256
# OTEL_BSP_SCHEDULE_DELAY=5000               # flush interval (ms)
# OTEL_EXPORTER_OTLP_TIMEOUT=10000           # per-request timeout (ms)
# OTEL_EXPORTER_OTLP_MAX_RETRIES=2           # bounded; a failed batch is dropped after this
# OTEL_EXPORTER_OTLP_RETRY_DELAY_MS=500
# OTEL_EXPORTER_OTLP_SHUTDOWN_TIMEOUT_MS=3000
#
# --- Multi-instance metrics aggregation (services/telemetry/sharedMetrics.js) ---
# Uses the EXISTING Redis connection (REDIS_URL, or REDIS_HOST/PORT/PASSWORD/DB above).
# When enabled but Redis is unreachable, the ops endpoint reports
# aggregation.mode='degraded' and keeps serving this instance's numbers.
# RAG_METRICS_SHARED_AGGREGATION=true
#
# --- Ops diagnostics endpoint access (Phase 5A, unchanged) ---
# RAG_METRICS_ENDPOINT_ENABLED=true          # required in production, WITH an admin caller
# RAG_METRICS_REQUIRE_AUTH=true              # opt into the production-like gate locally
# ============================================================
